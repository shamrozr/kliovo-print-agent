<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is allowed ONLY to the local network: thermal printers speak raw
  ESC/POS over TCP 9100 and have no certificates, and the bridge itself is
  http://127.0.0.1:6310. Everything else — the Dine cloud — stays HTTPS, which
  is what `cleartextTrafficPermitted="false"` on the base config enforces.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="true">10.0.0.0</domain>
    <domain includeSubdomains="true">192.168.0.0</domain>
    <domain includeSubdomains="true">172.16.0.0</domain>
  </domain-config>
</network-security-config>
